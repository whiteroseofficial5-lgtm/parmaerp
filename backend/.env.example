NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pharma:pharma@localhost:5432/pharmaerp?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-too-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./storage
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# AI document processing (Claude vision reads PDFs, scans and handwriting natively)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Optional local OCR fallback (tesseract.js) when no API key is configured
OCR_FALLBACK=true

# Alerts
EXPIRY_WARNING_DAYS=90
