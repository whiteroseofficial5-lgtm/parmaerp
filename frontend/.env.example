[TEMPLATE]

# ---------------------------------------------------------------------------
# DEMO MODE (default)
# The web app serves /api/* itself from in-memory sample data — no backend and
# no database are needed. Just `npm install && npm run dev` (or deploy the
# frontend anywhere). Sample data resets whenever the server restarts.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# REAL BACKEND
# Unset/false keeps demo mode. To use the Express/Prisma API instead, build the
# frontend with DEMO_MODE=false and point BACKEND_URL at the running backend:
#   DEMO_MODE=false
#   BACKEND_URL=http://localhost:4000
# ---------------------------------------------------------------------------

# Client-side flag: shows/hides the "Demo mode" banner. Keep in sync with DEMO_MODE.
NEXT_PUBLIC_DEMO_MODE=true
